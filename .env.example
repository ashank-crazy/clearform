# Needed for live explanations. Get a key at https://aistudio.google.com/apikey.
# Without it, the bundled samples show saved explanations.
GEMINI_API_KEY=
# Optional. Default to gemini-3.6-flash, then gemini-3.5-flash if it's busy or out of quota.
# Fallbacks are comma-separated and tried in order.
CLEARFORM_MODEL=
CLEARFORM_FALLBACK_MODELS=
